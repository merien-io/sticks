# ==========================================
# Working Documents, Notes & Design Specs
# ==========================================
definitions.md
*.draft
*.todo
*.scratch

# ==========================================
# Rust / Cargo
# ==========================================
# Generated build artifacts
target/
**/target/
**/*.rs.bk
*.bk

# Local Cargo configuration & credentials (often hold private tokens)
.cargo/config.toml
.cargo/credentials.toml

# Cargo profiling / bench / coverage output
cobertura.xml
*.profraw
*.profdata
*.gcda
*.gcno

# ==========================================
# Databases, WAL Files & Storage
# ==========================================
# SQLite databases, journals, WAL, SHM, and backups (any subdirectory)
*.db
*.db-*
*.db.bak
*.sqlite
*.sqlite3
*.sqlite3-*
*.sqlite.bak
*.sql.dump

# Explicit project runtime data directories
sticksdemo/data/*.db*
stickswebsite/data/*.db*
**/data/*.db*

# Keep schema files tracked even if inside data/
!**/data/*.sql

# ==========================================
# Environment, Secrets & Credentials
# ==========================================
.env
.env~
.env.*
.envrc
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
*.pub.key
*.secret

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ==========================================
# IDEs and Code Editors
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (IntelliJ, RustRover, CLion, etc.)
.idea/
*.iml

# Vim / Emacs / Sublime
*.swp
*.swo
*~
\#*\#
.\#*
*.sublime-project
*.sublime-workspace

# ==========================================
# Logs, Temp Files & Test Dumps
# ==========================================
*.log
logs/
tmp/
temp/
